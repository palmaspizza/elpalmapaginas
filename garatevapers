function openCloudinaryWidget(target) {
  const widget = cloudinary.createUploadWidget({
    cloudName:    CLOUD_NAME,
    uploadPreset: UPLOAD_PRESET,
    sources:      ['local', 'camera', 'url'],
    multiple:     false,
    language:     'es',
    maxFileSize:  8000000,
    clientAllowedFormats: ['jpg','jpeg','png','webp'],
    cropping: false,
    eager: [{ width: 800, crop: 'scale', quality: 'auto:good', fetch_format: 'auto' }]
  }, (error, result) => {
    if (error) { alert('Error al subir imagen: ' + error.message); return; }
    if (result && result.event === 'success') {
      // Usar URL optimizada con transformaciones Cloudinary
      const baseUrl = result.info.secure_url;
      const optimizedUrl = baseUrl.replace('/upload/', '/upload/w_800,q_auto,f_auto/');

      if (target === 'create') {
        currentProductImage = optimizedUrl;
        const preview = document.getElementById('img-upload-preview');
        preview.src = optimizedUrl;
        preview.style.display = 'block';
        document.getElementById('img-upload-btn-text').textContent = '✓ Imagen cargada — Clic para cambiar';
      } else if (target === 'edit') {
        editProductImage = optimizedUrl;
        const preview = document.getElementById('edit-img-preview');
        preview.src = optimizedUrl;
        preview.style.display = 'block';
        document.getElementById('edit-img-btn-text').textContent = '✓ Imagen actualizada';
      }
    }
  });
  widget.open();
}
function addCustomSize(form) {
  const wrapperId = form === 'create' ? 'custom-sizes-create' : 'custom-sizes-edit';
  const prefix    = form === 'create' ? 's-custom-' : 'es-custom-';
  const wrapper   = document.getElementById(wrapperId);
  if (!wrapper) return;

  // Crear un input inline en vez de prompt
  if (document.getElementById(prefix + 'input')) return; // ya hay uno abierto
  const inp = document.createElement('input');
  inp.type = 'text';
  inp.id = prefix + 'input';
  inp.className = 'form-ctrl';
  inp.placeholder = 'Ej: Extra Grande';
  inp.style.cssText = 'width:130px;height:34px;font-size:.78rem;padding:0 10px;display:inline-block;vertical-align:middle;';

  const btn = document.createElement('button');
  btn.type = 'button';
  btn.textContent = '✓';
  btn.style.cssText = 'margin-left:4px;padding:4px 10px;border-radius:7px;border:2px solid var(--pk);background:var(--pk-l);font-weight:800;cursor:pointer;vertical-align:middle;';

  const confirm = () => {
    const val = inp.value.trim();
    if (!val) { inp.remove(); btn.remove(); return; }
    const id = prefix + val.toLowerCase().replace(/\s+/g, '-');
    if (document.getElementById(id)) { inp.remove(); btn.remove(); return; }
    const cb = document.createElement('input');
    cb.type = 'checkbox'; cb.className = 'size-cb';
    cb.id = id; cb.value = val; cb.checked = true;
    const lbl = document.createElement('label');
    lbl.className = 'size-lbl'; lbl.htmlFor = id; lbl.textContent = val;
    inp.remove(); btn.remove();
    wrapper.appendChild(cb);
    wrapper.appendChild(lbl);
  };
  btn.onclick = confirm;
  inp.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); confirm(); } if (e.key === 'Escape') { inp.remove(); btn.remove(); } };
  wrapper.appendChild(inp);
  wrapper.appendChild(btn);
  inp.focus();
}
