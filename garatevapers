async function confirmOrder() {
  // Validaciones
  const nombre   = document.getElementById('co-nombre').value.trim();
  const apellido = document.getElementById('co-apellido').value.trim();
  const pago     = document.querySelector('input[name="pago"]:checked')?.value;
  const entregaDelivery = document.getElementById('btn-delivery').classList.contains('sel');
  const entregaRetiro   = document.getElementById('btn-retiro').classList.contains('sel');
  const direccion = document.getElementById('co-direccion').value.trim();
  const retiro    = document.querySelector('input[name="retiro"]:checked')?.value;

  let hasError = false;
  document.querySelectorAll('.error').forEach(el => el.classList.remove('error'));

  if (!nombre) { document.getElementById('co-nombre').classList.add('error'); hasError = true; }
  if (!apellido) { document.getElementById('co-apellido').classList.add('error'); hasError = true; }
  if (!pago) { document.querySelector('.pay-options').parentElement.classList.add('error'); hasError = true; }
  if (!entregaDelivery && !entregaRetiro) { document.querySelector('.entrega-opts').classList.add('error'); hasError = true; }
  
  if (entregaDelivery && !direccion) { document.getElementById('co-direccion').classList.add('error'); hasError = true; }
  if (entregaRetiro && !retiro) { document.querySelector('#retiro-section .retiro-opts').classList.add('error'); hasError = true; }

  if (hasError) {
    document.getElementById('checkout-req').style.display = 'block';
    document.getElementById('checkout-req').textContent = '⚠️ Por favor completá los campos marcados en rojo.';
    return;
  }
  document.getElementById('checkout-req').style.display = 'none';

  // Verificar stock de último momento y descontar
  try {
    for (const item of cart) {
      const snap = await db.ref('productos/' + item.productId + '/stock').get();
      const currentStock = snap.val() || 0;
      if (currentStock < item.cantidad) {
        alert(`¡Lo sentimos! Ya no queda stock suficiente para "${item.nombre}". Stock disponible: ${currentStock}. El pedido no pudo procesarse.`);
        return;
      }
    }

    // Si todo ok, descontar stock
    for (const item of cart) {
      await db.ref('productos/' + item.productId + '/stock').transaction(current => (current || 0) - item.cantidad);
    }
  } catch(e) {
    console.error(e);
    alert('Error al verificar stock. Intenta nuevamente.');
    return;
  }

  const total = cart.reduce((sum, i) => sum + (parseFloat(i.precio) * i.cantidad), 0);
  const tipoEntrega = entregaDelivery ? `🚚 Delivery a: ${direccion}` : `🏪 Retiro en: ${retiro}`;

  // Armar mensaje WhatsApp bonito
  const itemsText = cart.map((i,idx) =>
    `  Producto ${idx+1}:
    ${i.cantidad} *${i.nombre}*` +
    (i.talla  ? `\n     📏 Talla: ${i.talla}`  : '') +
    (i.color  ? `\n     🎨 Color: ${i.color}`  : '') +
    `\n     💰 Subtotal: $${fmtNum(i.precio * i.cantidad)}`
  ).join('\n\n');

  const msg = `✨ *NUEVO PEDIDO* ✨
━━━━━━━━━━━━━━━━━━━━━
👤 *Cliente:* ${nombre} ${apellido}
━━━━━━━━━━━━━━━━━━━━━

🛍️ *PRODUCTOS PEDIDOS:*

${itemsText}

━━━━━━━━━━━━━━━━━━━━━
💵 *Forma de pago:* ${pago}
📦 *Entrega:* ${tipoEntrega}
━━━━━━━━━━━━━━━━━━━━━
💎 *TOTAL: $${fmtNum(total)}*
━━━━━━━━━━━━━━━━━━━━━

¡Muchas gracias por tu compra! 🎀 
 Envía este mensaje👉🏻`;

  const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`;
  window.open(waUrl, '_blank');

  // Limpiar carrito
  cart = [];
  updateCartBadge();
  closeCheckout();
  showCartToast('🎉 ¡Pedido enviado! Gracias por tu compra.');
}

