function createProduct(e) {
  e.preventDefault();
  const nombre = document.getElementById('prod-nombre').value.trim();
  const precio = parseFloat(document.getElementById('prod-precio').value);
  if (!nombre) { showMsg('prod-form-msg', '⚠️ El nombre es obligatorio.', 'error'); return; }
  if (!precio || precio <= 0) { showMsg('prod-form-msg', '⚠️ El precio debe ser mayor a cero.', 'error'); return; }

  const ofertaVal = document.getElementById('prod-oferta').value;
  const precioOferta = ofertaVal ? parseFloat(ofertaVal) : null;
  if (precioOferta && precioOferta >= precio) { showMsg('prod-form-msg', '⚠️ El precio de oferta debe ser menor al precio normal.', 'error'); return; }

  const catSel = document.getElementById('prod-cat-select');
  const categoria = catSel.value;
  const catOpt = catSel.options[catSel.selectedIndex];
  const categoriaId = catOpt?.dataset?.id || '';
  const tallas = getCheckedSizes();

  const product = {
    nombre,
    descripcion:  document.getElementById('prod-desc').value.trim(),
    precio,
    precioOferta: precioOferta || null,
    tallas:       tallas.length ? tallas : [],
    colores:      productColors.length ? [...productColors] : [],
    categoria,
    categoriaId,
    genero:       document.getElementById('prod-genero').value,
    material:     document.getElementById('prod-material').value.trim(),
    stock:        parseInt(document.getElementById('prod-stock').value) || 0,
    destacado:    document.getElementById('prod-destacado').checked,
    imagen:       currentProductImage,
    fechaCreacion: Date.now()
  };

  db.ref('productos').push(product)
    .then(() => { showMsg('prod-form-msg', '🎉 ¡Producto publicado exitosamente!', 'success'); resetProductForm(); })
    .catch(err => showMsg('prod-form-msg', 'Error: ' + err.message, 'error'));
}

