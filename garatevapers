/* ╔══════════════════════════════════════════════════════════╗
   ║         DA LUC — PREMIUM STYLE & ANIMATIONS             ║
   ╚══════════════════════════════════════════════════════════╝ */

/* ─── KEYFRAMES GLOBALES ─────────────────────────────────── */

@keyframes fadeInUp {
  from { opacity:0; transform:translateY(32px); }
  to   { opacity:1; transform:translateY(0); }
}
@keyframes fadeInDown {
  from { opacity:0; transform:translateY(-24px); }
  to   { opacity:1; transform:translateY(0); }
}
@keyframes fadeInLeft {
  from { opacity:0; transform:translateX(-40px); }
  to   { opacity:1; transform:translateX(0); }
}
@keyframes fadeInRight {
  from { opacity:0; transform:translateX(40px); }
  to   { opacity:1; transform:translateX(0); }
}
@keyframes scaleIn {
  from { opacity:0; transform:scale(.85); }
  to   { opacity:1; transform:scale(1); }
}
@keyframes shimmer {
  0%   { background-position:-600px 0; }
  100% { background-position: 600px 0; }
}
@keyframes floatY {
  0%,100% { transform:translateY(0); }
  50%     { transform:translateY(-10px); }
}
@keyframes rotateSlow {
  from { transform:rotate(0deg); }
  to   { transform:rotate(360deg); }
}
@keyframes gradShift {
  0%   { background-position:0% 50%; }
  50%  { background-position:100% 50%; }
  100% { background-position:0% 50%; }
}
@keyframes sparkle {
  0%,100% { opacity:1; transform:scale(1) rotate(0deg); }
  25%     { opacity:.6; transform:scale(1.3) rotate(15deg); }
  75%     { opacity:.8; transform:scale(.8) rotate(-10deg); }
}
@keyframes borderGlow {
  0%,100% { box-shadow:0 0 0 2px rgba(0,194,255,.3), 0 8px 30px rgba(0,194,255,.12); }
  50%     { box-shadow:0 0 0 4px rgba(255,90,31,.5), 0 16px 50px rgba(255,90,31,.25); }
}
@keyframes ripple {
  0%   { transform:scale(1); opacity:.6; }
  100% { transform:scale(2.5); opacity:0; }
}
@keyframes slideInModal {
  from { opacity:0; transform:translateY(40px) scale(.95); }
  to   { opacity:1; transform:translateY(0) scale(1); }
}
@keyframes textGradFlow {
  0%   { background-position:0% center; }
  100% { background-position:200% center; }
}
@keyframes heartbeat {
  0%,100% { transform:scale(1); }
  14%     { transform:scale(1.15); }
  28%     { transform:scale(1); }
  42%     { transform:scale(1.1); }
  56%     { transform:scale(1); }
}
@keyframes glowPulse {
  0%,100% { opacity:.4; }
  50%     { opacity:1; }
}
@keyframes tickerFade {
  0%,100% { opacity:1; }
  50%     { opacity:.7; }
}
@keyframes cardReveal {
  from { opacity:0; transform:translateY(24px) scale(.97); }
  to   { opacity:1; transform:translateY(0) scale(1); }
}

/* ─── HEADER PREMIUM ─────────────────────────────────────── */

.site-header {
  box-shadow: 0 2px 24px rgba(0,194,255,.13);
  transition: box-shadow .3s, background .3s;
}
.site-header.scrolled {
  background: rgba(8,9,13,.97) !important;
  box-shadow: 0 4px 32px rgba(0,150,220,.14);
}

/* Logo — anillo giratorio suave */
#logo-circle {
  transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
}
#logo-circle::after {
  content:'';
  position:absolute; inset:-3px;
  border-radius:15px;
  background: conic-gradient(var(--pk), var(--li), var(--sky), var(--pk));
  animation: rotateSlow 4s linear infinite;
  z-index:-1;
  opacity:.55;
}
#logo-circle:hover {
  transform: scale(1.08) rotate(-4deg);
  box-shadow: 0 10px 30px rgba(0,194,255,.45);
}

/* Brand name — degradado animado */
.brand-name {
  background: linear-gradient(120deg, var(--dk) 0%, var(--pk-b) 40%, var(--li-d) 70%, var(--dk) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: textGradFlow 4s linear infinite;
}

/* Nav links — subrayado animado */
.site-nav a {
  position: relative;
  overflow: hidden;
}
.site-nav a::after {
  content:'';
  position:absolute; bottom:4px; left:50%;
  width:0; height:2px;
  background: linear-gradient(to right, var(--pk-b), var(--li-d));
  border-radius:2px;
  transition: width .3s ease, left .3s ease;
}
.site-nav a:hover::after {
  width: 60%;
  left: 20%;
}

/* Buscador — efecto glow al focus */
.search-wrap input:focus {
  box-shadow: 0 0 0 3px rgba(0,194,255,.25), 0 4px 16px rgba(0,194,255,.15);
}

/* Carrito — animación mejorada */
.cart-btn-wrap::before {
  border-radius: 16px;
  background: linear-gradient(135deg, var(--pk), var(--li), var(--sky), var(--pk-b));
  background-size: 300% 300%;
  animation: gradShift 3s ease infinite;
  opacity: .7;
}
.cart-btn {
  transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s !important;
}
.cart-btn:hover {
  transform: scale(1.12) translateY(-2px) !important;
}
.cart-badge {
  animation: heartbeat 1.4s ease infinite !important;
}

/* Hamburguesa — hover animado */
.hamburger:hover span:nth-child(1) { transform: translateX(3px); }
.hamburger:hover span:nth-child(2) { transform: scaleX(.7); }
.hamburger:hover span:nth-child(3) { transform: translateX(-3px); }
.hamburger span { transition: transform .25s ease; }

/* ─── HERO PREMIUM ───────────────────────────────────────── */

.hero {
  background: linear-gradient(135deg, var(--pk-l) 0%, var(--yw) 45%, var(--sky-l) 100%);
  background-size: 300% 300%;
  animation: gradShift 10s ease infinite;
}

/* Orbes decorativos extra */
.hero::before {
  animation: floatY 7s ease-in-out infinite, glowPulse 4s ease-in-out infinite;
  width:500px; height:500px;
}
.hero::after {
  animation: floatY 9s ease-in-out infinite reverse, glowPulse 5s ease-in-out infinite;
  width:380px; height:380px;
}

.hero-badge {
  animation: fadeInDown .7s ease both, borderGlow 3s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}
/* Shimmer en el badge */
.hero-badge::after {
  content:'';
  position:absolute; top:0; left:-100%;
  width:60%; height:100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
  animation: shimmer 2.5s ease infinite;
}

.hero-title {
  animation: fadeInUp .8s .15s ease both;
}
.hero-title em {
  background: linear-gradient(135deg, var(--pk-b), var(--li-d), #FF5A1F);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: textGradFlow 3s linear infinite;
}

.hero-sub   { animation: fadeInUp .8s .28s ease both; }
.hero-btns  { animation: fadeInUp .8s .38s ease both; }
.hero-tags  { animation: fadeInUp .8s .50s ease both; }

.btn-hero-p {
  position: relative;
  overflow: hidden;
  background-size: 200% auto;
  animation: gradShift 4s ease infinite;
}
.btn-hero-p::before {
  content:'';
  position:absolute; inset:0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
  transform: translateX(-100%);
  transition: transform .5s ease;
}
.btn-hero-p:hover::before { transform: translateX(100%); }
.btn-hero-p:hover { transform: translateY(-4px) scale(1.03) !important; }

.hero-tag {
  transition: all .25s;
  backdrop-filter: blur(8px);
}
.hero-tag:hover {
  background: rgba(0,194,255,.12);
  border-color: var(--pk);
  color: var(--pk);
  transform: translateY(-2px);
}

/* ─── TICKER PREMIUM ─────────────────────────────────────── */

.ticker-wrap {
  background: linear-gradient(135deg, var(--dk) 0%, #160B2E 50%, var(--dk) 100%);
  background-size: 200% auto;
  animation: gradShift 8s ease infinite;
  box-shadow: 0 4px 24px rgba(5,6,10,.2);
}
.t-item {
  animation: tickerFade 3s ease-in-out infinite;
  transition: color .2s;
  letter-spacing:4px;
