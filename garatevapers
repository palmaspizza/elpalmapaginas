<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content='Gárate Vapes — Vapes, pods y líquidos premium. Calidad y variedad para verdaderos vapers. +18.'>
  <meta name="theme-color" content="#08090D">
  <title>Gárate Vapes ⚡ Tienda Online</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2300C2FF' stroke-width='2'%3E%3Cpath d='M18.5 8c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1S6 8 4.5 8 3 9 3 9v7a2 2 0 002 2h13a3 3 0 003-3v-3a4 4 0 00-4-4h1.5z'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Firebase Compat -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
  <!-- Cloudinary Upload Widget -->
  <script src="https://upload-widget.cloudinary.com/global/all.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* =============================================
       VARIABLES & RESET — Paleta Kinder Kind suave
    ============================================= */
    :root {
      /* Acento principal — azul eléctrico vapor */
      --pk:    #00C2FF;   /* azul eléctrico */
      --pk-l:  #0B1B26;   /* superficie azul muy oscura */
      --pk-b:  #FF5A1F;   /* naranja quemado (acento fuego) */
      --pk-xl: #070B0F;

      /* Ámbar / advertencia nicotina */
      --yw:    #1C1608;
      --yw-w:  #FFC107;

      /* Cian / menta neón */
      --sky:   #00FFC2;
      --sky-l: #06201C;

      /* Púrpura tech */
      --li:    #8B5CF6;
      --li-l:  #150C26;
      --li-d:  #7C3AED;
      --li-x:  #1F0F3D;

      /* Verde neón (stock / éxito) */
      --gr:    #39FF14;
      --gr-l:  #0A1F04;

      /* Neutros — modo oscuro masculino */
      --bg:    #08090D;
      --wh:    #14161C;
      --card:  #15171E;
      --ink:   #F2F3F7;
      --dk:    #050608;
      --tx:    #B6B9C4;
      --tx-l:  #767A87;
      --brd:   rgba(255, 255, 255, 0.08);
      --sh:    0 8px 30px rgba(0,0,0,0.45);
      --sh-h:  0 15px 45px rgba(0,194,255,0.22);
      --r:     12px; --rs: 6px; --rx: 20px;
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior: smooth; }
    body { font-family:'Inter', sans-serif; background:var(--bg); color:var(--ink); overflow-x:hidden; -webkit-font-smoothing: antialiased; }
    img { display:block; max-width:100%; }
    button { cursor:pointer; font-family:'Inter', sans-serif; outline: none; border: none; }
    a { text-decoration:none; color: inherit; }
    input,textarea,select { font-family:'Inter', sans-serif; }

    /* Estilos para Lucide Icons */
    .lucide { width: 20px; height: 20px; stroke-width: 2px; }
    .lucide-lg { width: 24px; height: 24px; }
    .lucide-sm { width: 16px; height: 16px; }

    /* =============================================
       HEADER
    ============================================= */
    .site-header {
      position:sticky; top:0; z-index:200;
      background:rgba(8, 9, 13, 0.85);
      backdrop-filter:blur(15px); -webkit-backdrop-filter:blur(15px);
      border-bottom:1px solid var(--brd); padding:0 24px;
    }
    .header-inner {
      max-width:1260px; margin:0 auto;
      display:flex; align-items:center; gap:24px; height:72px;
    }
    #logo-circle {
      width:48px; height:48px; border-radius:12px;
      background:linear-gradient(135deg, var(--pk-l), var(--li-l));
      border:1px solid var(--pk); flex-shrink:0;
      display:flex; align-items:center; justify-content:center;
      cursor:pointer; transition:all .3s cubic-bezier(0.4, 0, 0.2, 1);
      position:relative; overflow:hidden; user-select:none;
    }
    #logo-circle:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(0,194,255,.3); }
    #logo-circle:active { transform:scale(.95); }
    .logo-hint { font-size:10px; color:var(--tx-l); text-align:center; font-weight:700; text-transform:uppercase; letter-spacing:1px; }

    .brand-name {
  font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:800;
  color:var(--ink); letter-spacing: -0.5px;
  white-space: nowrap;
  flex-shrink: 0;
}
    .site-nav { display:flex; gap:8px; margin-left:auto; }
    .site-nav a {
      font-size:.85rem; font-weight:600; color:var(--tx);
      padding:8px 16px; border-radius:8px; transition:all .2s;
    }
    .site-nav a:hover { background:var(--pk-l); color:var(--pk-b); }

    /* CARRITO BTN */
    .cart-btn {
      position:relative; background:var(--wh); border:1px solid var(--brd) !important;
      padding:10px; border-radius:12px;
      transition:all .2s;     color: #00C2FF;
      display: flex; align-items: center; justify-content: center;
    }
    .cart-btn:hover { transform:translateY(-2px); box-shadow: var(--sh); border-color: var(--pk); }
    .cart-badge {
      position:absolute; top:-6px; right:-6px;
      background:var(--pk-b); color:#fff;
      font-size:.7rem; font-weight:800; min-width:20px; height:20px;
      border-radius:50px; display:flex; align-items:center; justify-content:center;
      border:2px solid var(--wh); padding:0 4px;
      animation:cartPop .3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes cartPop { 0%{transform:scale(0)} 60%{transform:scale(1.3)} 100%{transform:scale(1)} }

    /* SEARCH */
    .search-wrap { position:relative; max-width:240px; width:100%; }
    .search-wrap input {
      width:100%; padding:8px 16px 8px 38px;
      border:2px solid var(--brd); border-radius:50px;
      background:var(--wh); color:var(--ink); font-size:.83rem;
      outline:none; transition:border-color .2s;
    }
    .search-wrap input:focus { border-color:var(--pk); }
    .search-wrap input::placeholder { color:var(--tx-l); }
    .search-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); font-size:1rem; pointer-events:none; }

    /* HAMBURGER */
    .hamburger { display:none; background:none; border:none; flex-direction:column; gap:5px; padding:4px; }
    .hamburger span { display:block; width:22px; height:2px; background:var(--dk); border-radius:2px; transition:.3s; }
    .mobile-menu {
      display:none; position:fixed; inset:0; top:68px;
      background:rgba(8,9,13,.98); z-index:190;
      flex-direction:column; align-items:center; justify-content:center; gap:20px;
    }
    .mobile-menu.open { display:flex; }
    .mobile-menu a { font-size:1.2rem; font-weight:700; color:var(--ink); padding:12px 32px; border-radius:50px; text-align:center; }
    .mobile-menu a:hover { background:var(--pk-l); color:var(--pk-b); }
/* grupo derecho header */
    .header-right { display:flex; align-items:center; gap:10px; flex-shrink:0; }

    /* =============================================
       MOBILE HEADER ≤768px
    ============================================= */
    @media (max-width: 768px) {
      .site-header { padding:0 14px; }
      .header-inner { gap:10px; height:64px; }

      /* nombre oculto en móvil, el logo lo representa */
      .brand-name { display:block; font-size:.85rem; }

      /* nav desktop oculta */
      .site-nav { display:none; }

      /* buscador ocupa todo el espacio del medio */
      .search-wrap { flex:1; max-width:none; min-width:0; }

      /* hamburguesa visible */
      .hamburger { display:flex; }
    }
    /* =============================================
       HERO
    ============================================= */
    .hero {
      position:relative; overflow:hidden;
      background:linear-gradient(135deg, var(--pk-l) 0%, var(--yw) 45%, var(--sky-l) 100%);
      padding:90px 24px 80px; text-align:center;
    }
    .hero::before {
      content:''; position:absolute; top:-80px; right:-80px;
      width:360px; height:360px; border-radius:50%;
      background:radial-gradient(circle, rgba(0,194,255,.20), transparent 70%);
    }
    .hero::after {
      content:''; position:absolute; bottom:-60px; left:-60px;
      width:280px; height:280px; border-radius:50%;
      background:radial-gradient(circle, rgba(163,237,248,.22), transparent 70%);
    }
    .hero-inner { position:relative; z-index:1; max-width:700px; margin:0 auto; }
    .hero-badge {
      display:inline-block;
      background:linear-gradient(135deg, var(--pk-b), var(--li-d));
      color:#fff; font-size:.7rem; font-weight:800;
      letter-spacing:3px; text-transform:uppercase;
      padding:6px 20px; border-radius:50px; margin-bottom:22px;
      box-shadow:0 6px 20px rgba(255,90,31,.25);
    }
    .hero-title {
      font-family:'Playfair Display',serif;
      font-size:clamp(2.2rem, 5.5vw, 4.2rem); font-weight:900;
      color:var(--ink); line-height:1.08; margin-bottom:18px;
    }
    .hero-title em { font-style:italic; color:var(--pk-b); }
    .hero-sub { font-size:1rem; color:var(--tx); font-weight:400; letter-spacing:.5px; margin-bottom:36px; line-height:1.7; }
    .hero-btns { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
    .btn-hero-p {
      background:linear-gradient(135deg, var(--pk-b), var(--li-d));
      color:#fff; border:none; padding:14px 36px; border-radius:50px;
      font-size:.95rem; font-weight:700; letter-spacing:.5px;
      transition:all .3s; box-shadow:0 8px 26px rgba(255,90,31,.28);
    }
    .btn-hero-p:hover { transform:translateY(-3px); box-shadow:0 14px 36px rgba(255,90,31,.38); }
    .btn-hero-s {
      background:rgba(255,255,255,.06); color:var(--ink);
      border:2px solid rgba(0,150,220,.4); padding:12px 32px;
      border-radius:50px; font-size:.9rem; font-weight:700;
      transition:all .3s; backdrop-filter:blur(8px);
    }
    .btn-hero-s:hover { background:var(--pk-l); border-color:var(--pk); color:var(--pk); }
    .hero-tags { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:30px; }
    .hero-tag {
      font-size:.72rem; font-weight:700; letter-spacing:1.5px;
      text-transform:uppercase; color:var(--pk-b);
      padding:5px 14px; border:1px solid var(--pk-b);
      border-radius:50px; background:rgba(255,255,255,.05); backdrop-filter:blur(6px);
    }

    /* PUNTOS DE RETIRO EN HERO */
    .pickup-strip {
      background:linear-gradient(135deg, var(--li-l), var(--sky-l));
      border-top:1px solid var(--brd); border-bottom:1px solid var(--brd);
      padding:22px 24px; text-align:center;
    }
    .pickup-title {
      font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700;
      color:var(--ink); margin-bottom:14px;
    }
    .pickup-title span { color:var(--pk-b); }
    .pickup-points { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
    .pickup-point {
      background:var(--wh); border:1.5px solid var(--pk-l);
      border-radius:var(--r); padding:12px 20px;
      display:flex; align-items:center; gap:9px;
      box-shadow:var(--sh);
    }
    .pickup-point .pp-icon { font-size:1.4rem; }
    .pickup-point .pp-info { text-align:left; }
    .pickup-point .pp-label { font-size:.68rem; font-weight:800; text-transform:uppercase; letter-spacing:1.5px; color:var(--pk-b); }
    .pickup-point .pp-addr { font-size:.82rem; font-weight:600; color:var(--ink); }

    /* =============================================
       TICKER
    ============================================= */
    .ticker-wrap { background:var(--dk); padding:11px 0; overflow:hidden; white-space:nowrap; }
    .ticker-inner { display:inline-flex; animation:ticker 35s linear infinite; }
    .ticker-inner:hover { animation-play-state:paused; }
    .t-item { color:var(--yw-w); font-size:.72rem; font-weight:800; letter-spacing:3px; text-transform:uppercase; padding:0 36px; }
    .t-sep { color:var(--pk); font-size:.7rem; }
    @keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

    /* =============================================
       SECTION COMMONS
    ============================================= */
    .section-wrap { max-width:1260px; margin:0 auto; padding:0 24px; }
    .section-head { margin-bottom:28px; }
    .section-title { font-family:'Playfair Display',serif; font-size:1.85rem; font-weight:700; color:var(--ink); margin-bottom:8px; }
    .section-line { width:48px; height:3px; background:linear-gradient(to right, var(--pk), var(--li)); border-radius:2px; }

    /* =============================================
       CATEGORIES
    ============================================= */
    .cats-section { padding:42px 0 18px; }
    .cat-scroll { display:flex; gap:10px; flex-wrap:wrap; padding:4px 0; }
    .cat-btn { padding:9px 22px; border:2px solid var(--brd); border-radius:50px; background:var(--wh); color:var(--tx); font-size:.82rem; font-weight:700; transition:all .22s; white-space:nowrap; }
    .cat-btn:hover { border-color:var(--pk); color:var(--pk-b); background:var(--pk-l); }
    .cat-btn.active { background:linear-gradient(135deg, var(--pk), var(--li)); border-color:transparent; color:#fff; box-shadow:0 6px 20px rgba(0,150,220,.22); }

    /* =============================================
       PRODUCTS SECTION
    ============================================= */
    .products-section { padding:18px 0 70px; }
    .products-topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:22px; gap:12px; flex-wrap:wrap; }
    .products-count { font-size:.82rem; color:var(--tx-l); font-weight:600; }
    #products-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(220px,1fr)); gap:22px; }

    /* PRODUCT CARD */
    .product-card {
      background:var(--wh); border-radius:var(--rx);
      overflow:hidden; box-shadow:var(--sh);
      border:1px solid var(--brd); cursor:pointer;
      transition:all .3s ease; position:relative;
    }
    .product-card:hover { transform:translateY(-7px); box-shadow:var(--sh-h); }
    .pcard-img-wrap { position:relative; padding-top:115%; overflow:hidden; background:var(--li-l); }
    .pcard-img-wrap img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .55s ease; }
    .product-card:hover .pcard-img-wrap img { transform:scale(1.06); }
    .no-img { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:3.5rem; }
    .badge { position:absolute; border-radius:50px; font-size:.68rem; font-weight:800; padding:5px 11px; letter-spacing:.5px; z-index:2; }
    .badge-sale { top:12px; left:12px; background:linear-gradient(135deg,#00C2FF,#FF5A1F); color:#fff; animation:pulseBadge 1.8s ease-in-out infinite; box-shadow:0 4px 14px rgba(255,90,31,.4); }
    .badge-new { top:12px; left:12px; background:var(--li-d); color:#fff; }
    .badge-feat { top:12px; right:12px; background:var(--yw-w); color:#0A0A0A; }
    @keyframes pulseBadge { 0%,100%{transform:scale(1)} 50%{transform:scale(1.09)} }
    .card-body { padding:14px 16px 16px; }
    .card-cat { font-size:.68rem; font-weight:800; color:var(--li-d); text-transform:uppercase; letter-spacing:1.5px; }
    .card-name { font-family:'Playfair Display',serif; font-size:.97rem; font-weight:600; color:var(--ink); margin:5px 0 9px; line-height:1.28; }
    .card-pricing { margin-bottom:9px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .price-reg { font-size:1.1rem; font-weight:700; color:var(--ink); }
    .price-old { font-size:.85rem; font-weight:400; color:var(--tx-l); text-decoration:line-through; }
    .price-offer { font-size:1.22rem; font-weight:800; background:linear-gradient(135deg,#00C2FF,#FF5A1F); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .card-sizes { display:flex; gap:5px; flex-wrap:wrap; margin-bottom:7px; }
    .card-sizes span { font-size:.65rem; font-weight:700; padding:3px 8px; border-radius:5px; background:var(--li-l); color:var(--li-d); }
    .card-colors { display:flex; gap:5px; }
    .cdot { display:inline-block; width:16px; height:16px; border-radius:50%; border:2px solid #fff; box-shadow:0 0 0 1.5px var(--brd); }

    /* BTN AGREGAR AL CARRITO en tarjeta */
    .btn-add-cart-card {
      width:100%; margin-top:11px;
      background:linear-gradient(135deg, var(--pk), var(--li));
      color:#fff; border:none; padding:10px; border-radius:50px;
      font-size:.8rem; font-weight:800; letter-spacing:.3px;
      transition:all .25s; box-shadow:0 4px 16px rgba(255,90,31,.2);
       background:linear-gradient(135deg, var(--pk-b), var(--li-d));
      color:#fff; border:none; padding:16px 28px; border-radius:50px;
      font-size:1rem; font-weight:800; letter-spacing:.3px;
      transition:all .3s; box-shadow:0 8px 26px rgba(255,90,31,.28);
      display:flex; align-items:center; justify-content:center; gap:8px;
    }
    .btn-add-cart-card:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(255,90,31,.32); }

    /* VER MÁS PRODUCTOS */
    .load-more-wrap { text-align:center; margin-top:36px; }
    .btn-load-more {
      background:var(--wh); color:var(--pk-b);
      border:2px solid var(--pk); padding:13px 38px; border-radius:50px;
      font-size:.9rem; font-weight:800; transition:all .3s;
      box-shadow:var(--sh);
    }
    .btn-load-more:hover { background:var(--pk-l); transform:translateY(-2px); }
    .btn-load-more:disabled { opacity:.5; cursor:default; transform:none; }

    /* EMPTY STATE */
    .empty-state { grid-column:1/-1; text-align:center; padding:70px 20px; }
    .empty-state .ei { font-size:3.5rem; margin-bottom:14px; }
    .empty-state h3 { font-family:'Playfair Display',serif; font-size:1.5rem; color:var(--ink); margin-bottom:8px; }
    .empty-state p { color:var(--tx-l); font-size:.9rem; }

    /* =============================================
       PROMO BANNER
    ============================================= */
    .promo-banner {
      background:linear-gradient(135deg, var(--li-d) 0%, var(--pk-b) 60%, var(--li-x) 100%);
      padding:56px 24px; text-align:center; position:relative; overflow:hidden;
    }
    .promo-inner { position:relative; z-index:1; max-width:600px; margin:0 auto; }
    .promo-label {
      display:inline-block; background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.4);
      color:#fff; font-size:.68rem; font-weight:800; letter-spacing:3px; text-transform:uppercase;
      padding:5px 16px; border-radius:50px; margin-bottom:16px; backdrop-filter:blur(4px);
    }
    .promo-title { font-family:'Playfair Display',serif; font-size:clamp(1.8rem,4vw,3rem); font-weight:900; color:#fff; margin-bottom:12px; }
    .promo-sub { font-size:.92rem; color:rgba(255,255,255,.82); margin-bottom:28px; line-height:1.7; }
    .btn-promo {
      background:var(--card); color:var(--pk-b); border:none; padding:14px 38px; border-radius:50px;
      font-size:.95rem; font-weight:800; transition:all .3s; box-shadow:0 8px 28px rgba(0,0,0,.15);
    }
    .btn-promo:hover { transform:translateY(-3px); box-shadow:0 14px 36px rgba(0,0,0,.2); }

    /* =============================================
       FEATURES
    ============================================= */
    .features-section { padding:56px 0; }
    .features-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:24px; max-width:1260px; margin:0 auto; padding:0 24px; }
    .feat-item { background:var(--wh); border-radius:var(--r); padding:28px 22px; text-align:center; border:1px solid var(--brd); box-shadow:var(--sh); transition:all .3s; }
    .feat-item:hover { transform:translateY(-4px); box-shadow:var(--sh-h); }
    .feat-icon { font-size:2.2rem; margin-bottom:14px; }
    .feat-title { font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:700; color:var(--ink); margin-bottom:8px; }
    .feat-desc { font-size:.82rem; color:var(--tx-l); line-height:1.65; }

    /* ABOUT STRIP */
    .about-strip { background:linear-gradient(135deg, var(--pk-xl), var(--li-l)); padding:60px 0; }
    .about-inner { display:grid; grid-template-columns:1fr 1fr; gap:50px; align-items:center; }
    .about-text h2 { font-family:'Playfair Display',serif; font-size:2.2rem; font-weight:900; color:var(--ink); margin-bottom:16px; }
    .about-text h2 em { font-style:italic; color:var(--pk-b); }
    .about-text p { font-size:.9rem; color:var(--tx); line-height:1.8; margin-bottom:12px; }
    .about-slogans { display:flex; flex-direction:column; gap:14px; }
    .slogan-chip { display:flex; align-items:center; gap:16px; background:var(--wh); border-radius:var(--r); padding:16px 20px; box-shadow:var(--sh); }
    .sc-icon { font-size:1.8rem; }
    .sc-text { font-weight:800; color:var(--ink); font-size:.9rem; }
    .sc-sub { font-size:.75rem; color:var(--tx-l); }

    /* SCROLL TO TOP */
    .scroll-top-btn {
      position:fixed; bottom:24px; right:24px; z-index:300;
      width:44px; height:44px; border-radius:50%;
      background:linear-gradient(135deg, var(--pk-b), var(--li-d));
      color:#fff; border:none; font-size:1.1rem;
      box-shadow:0 6px 20px rgba(255,90,31,.38);
      opacity:0; pointer-events:none; transition:all .3s;
    }
    .scroll-top-btn.show { opacity:1; pointer-events:auto; }
