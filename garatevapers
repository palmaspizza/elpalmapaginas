  const hasColors = p.colores && p.colores.length > 0;

  const esUnico = p.tallas && p.tallas.length === 1 && p.tallas[0] === 'Único';
  if (esUnico) selectedSize = 'Único';
  if (hasSizes && !esUnico && !selectedSize) {
    alert('Por favor seleccioná una talla.');
    return;
  }
  if (hasColors && !selectedColor) {
    alert('Por favor seleccioná un color.');
    return;
  }

  // Verificar si ya hay unidades de este mismo producto (misma talla/color) en el carrito
  const existingInCart = cart.filter(i => i.productId === productId && i.talla === selectedSize && i.color === selectedColor);
  const totalInCart = existingInCart.reduce((sum, i) => sum + i.cantidad, 0);
  
  if (totalInCart + currentDetailQty > p.stock) {
    alert(`Lo sentimos, solo quedan ${p.stock} unidades de este producto y ya tenés ${totalInCart} en el carrito.`);
    return;
  }

  const price = (p.precioOferta && parseFloat(p.precioOferta) > 0) ? p.precioOferta : p.precio;

  // Buscar si ya existe el grupo para sumar cantidad
  const groupIdx = cart.findIndex(i => i.productId === productId && i.talla === selectedSize && i.color === selectedColor);
  
  if (groupIdx > -1) {
    cart[groupIdx].cantidad += currentDetailQty;
  } else {
    const cartItem = {
      id: Date.now() + Math.random(),
      productId: p.id,
      nombre: p.nombre,
      imagen: p.imagen || '',
      talla: selectedSize,
      color: selectedColor,
      precio: price,
      cantidad: currentDetailQty
    };
    cart.push(cartItem);
  }

  updateCartBadge();
  closeModal('modal-product-detail');

  // Feedback visual llamativo
  showCartToast(`✓ Agregado: ${p.nombre} (${currentDetailQty} ud)`);
}

