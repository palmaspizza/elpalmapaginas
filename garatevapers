function updateDetailQty(delta) {
  const p = allProducts.find(x => x.id === currentDetailProductId);
  if (!p) return;
  
  const newVal = currentDetailQty + delta;
  if (newVal < 1 || newVal > p.stock) return;
  
  currentDetailQty = newVal;
  document.getElementById('qty-val').textContent = currentDetailQty;
  document.getElementById('qty-minus').disabled = (currentDetailQty <= 1);
  document.getElementById('qty-plus').disabled = (currentDetailQty >= p.stock);
}

function selectDetailSize(el, size) {
  document.querySelectorAll('#pd-sizes-list .pd-size').forEach(s => s.classList.remove('selected'));
  el.classList.add('selected');
  selectedSize = size;
}

function selectDetailColor(el, colorName) {
  document.querySelectorAll('#pd-colors-list .pd-color-item').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  selectedColor = colorName;
}

