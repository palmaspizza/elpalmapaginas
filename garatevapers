/* ── tab activo en inventario (agotados por defecto) ── */
let currentInvTab = 'agotados';

function switchInvTab(tab) {
  currentInvTab = tab;
  document.querySelectorAll('.inv-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('inv-tab-' + tab).classList.add('active');
  renderAdminProducts();
}

function renderAdminProducts() {
  const container = document.getElementById('admin-prod-list');
  if (!allProducts.length) { container.innerHTML = '<p class="empty-msg">No hay productos aún.</p>'; return; }

  /* filtrar según el sub-tab activo */
  let lista = [...allProducts];
  if (currentInvTab === 'agotados') {
    lista = lista.filter(p => (p.stock || 0) === 0);
  } else if (currentInvTab === 'disponibles') {
    lista = lista.filter(p => (p.stock || 0) > 0);
    /* ordenar de menor a mayor stock */
    lista.sort((a, b) => (a.stock || 0) - (b.stock || 0));
  }
  /* 'todos' no filtra ni ordena, deja el orden original */

  if (!lista.length) {
    const msgs = {
      agotados:    '🎉 ¡No hay productos agotados!',
      disponibles: 'No hay productos con stock disponible.',
      todos:       'No hay productos aún.'
    };
    container.innerHTML = `<p class="empty-msg">${msgs[currentInvTab]}</p>`;
    return;
  }

  container.innerHTML = lista.map(p => {
    const hasOffer  = p.precioOferta && parseFloat(p.precioOferta) > 0;
    const stock     = p.stock || 0;
    const isOut     = stock === 0;
    const lowStock  = !isOut && stock < 7;

    return `<div class="aprow" data-id="${p.id}">
      <div class="aprow-img">
        ${p.imagen
          ? `<img src="${escHtml(optimizeCloudinaryUrl(p.imagen))}" alt="${escHtml(p.nombre)}" loading="lazy" onerror="this.parentElement.innerHTML='<i data-lucide=&quot;shirt&quot;></i>'">`
          : '<i data-lucide="shirt"></i>'}
      </div>
      <div class="aprow-info">
        <strong>
          ${escHtml(p.nombre)}
          ${lowStock ? `<span class="badge-low-stock">⚡ Poco stock</span>` : ''}
        </strong>
        <span class="aprow-cat">${p.categoria ? escHtml(p.categoria) : 'Sin categoría'}</span>
        <span class="aprow-price">$${fmtNum(p.precio)}${hasOffer ? ` → $${fmtNum(p.precioOferta)}` : ''}</span>
        <span style="font-size:.75rem;font-weight:700;color:${isOut ? '#FF5252' : lowStock ? '#FF5A1F' : '#39D353'};">
          ${isOut ? '🚫 Agotado' : `Stock: ${stock} unidades`}
        </span>
      </div>
      <div class="aprow-actions">
        <button class="btn-edit" data-action="edit">Editar</button>
        <button class="btn-del" data-action="del">Eliminar</button>
      </div>
    </div>`;
  }).join('');
    container.querySelectorAll('.aprow').forEach(row => {
    const id = row.dataset.id;
    row.querySelector('[data-action="edit"]').addEventListener('click', () => openEditModal(id));
    row.querySelector('[data-action="del"]').addEventListener('click', () => deleteProduct(id));
  });
  lucide.createIcons();
}


