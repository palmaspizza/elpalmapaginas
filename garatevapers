function changeCartQty(itemId, delta) {
  const idx = cart.findIndex(i => i.id === itemId);
  if (idx === -1) return;
  const item = cart[idx];
  const producto = allProducts.find(x => x.id === item.productId);
  const stockDisponible = producto ? (producto.stock || 0) : 0;
  if (delta > 0 && item.cantidad >= stockDisponible) {
    showToast(`Solo quedan ${stockDisponible} unidades disponibles`);
    return;
  }
  item.cantidad += delta;
  if (item.cantidad <= 0) {
    cart.splice(idx, 1);
  }
  updateCartBadge();
  renderCartBody();
}

