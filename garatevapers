  if (customWrap) customWrap.innerHTML = '';

  // Marcar los fijos
  document.querySelectorAll('#edit-sizes-wrap .size-cb').forEach(cb => {
    cb.checked = (p.tallas || []).includes(cb.value);
  });

  // Recrear los tamaños custom que no están en los fijos
  const fijos = ['XS','S','M','L','XL','XXL','XXXL','Único','32','34','36','38','40','Pequeño','Mediano','Grande'];
  (p.tallas || []).forEach(t => {
    if (!fijos.includes(t)) addCustomSize('edit');
  });
  // marcarlos como checked
  document.querySelectorAll('#edit-sizes-wrap .size-cb').forEach(cb => {
    cb.checked = (p.tallas || []).includes(cb.value);
  });
  } catch(e) { console.error('tallas falló:', e); }

  try { renderEditColors(); } catch(e) { console.error('renderEditColors falló:', e); }

  console.log('Abriendo modal...');
  document.getElementById('modal-edit-product').classList.add('active');
  document.body.style.overflow = 'hidden';
  console.log('Modal clases:', document.getElementById('modal-edit-product').className);
}

function closeEditModal() {
  document.getElementById('modal-edit-product').classList.remove('active');
   document.getElementById('modal-admin-panel').style.zIndex = '500';
  document.body.style.overflow = '';
}

function saveEditProduct(e) {
  e.preventDefault();
  const id     = document.getElementById('edit-prod-id').value;
  const nombre = document.getElementById('edit-nombre').value.trim();
  const precio = parseFloat(document.getElementById('edit-precio').value);
  if (!nombre) { showMsg('edit-form-msg', '⚠️ El nombre es obligatorio.', 'error'); return; }
  if (!precio || precio <= 0) { showMsg('edit-form-msg', '⚠️ El precio debe ser mayor a cero.', 'error'); return; }

  const ofertaVal = document.getElementById('edit-oferta').value;
  const precioOferta = ofertaVal ? parseFloat(ofertaVal) : null;
  if (precioOferta && precioOferta >= precio) { showMsg('edit-form-msg', '⚠️ El precio de oferta debe ser menor al precio normal.', 'error'); return; }

  const catSel = document.getElementById('edit-cat-select');
  const categoria = catSel.value;
  const catOpt = catSel.options[catSel.selectedIndex];
  const categoriaId = catOpt?.dataset?.id || '';

  const tallas = [];
  document.querySelectorAll('#edit-sizes-wrap .size-cb:checked').forEach(cb => tallas.push(cb.value));

  const updates = {
    nombre,
    descripcion:  document.getElementById('edit-desc').value.trim(),
    precio,
    precioOferta: precioOferta || null,
    tallas:       tallas.length ? tallas : [],
    colores:      editColors.length ? [...editColors] : [],
    categoria,
    categoriaId,
    genero:       document.getElementById('edit-genero').value,
    material:     document.getElementById('edit-material').value.trim(),
    stock:        parseInt(document.getElementById('edit-stock').value) || 0,
    destacado:    document.getElementById('edit-destacado').checked,
    imagen:       editProductImage,
  };

  db.ref('productos/' + id).update(updates)
    .then(() => {
      showMsg('edit-form-msg', '✓ ¡Producto actualizado correctamente!', 'success');
      setTimeout(() => closeEditModal(), 1200);
    })
    .catch(err => showMsg('edit-form-msg', 'Error: ' + err.message, 'error'));
}

/* ================================================
   EDIT PRODUCT — COLORS
================================================ */
function addEditColor() {
  const hex  = document.getElementById('edit-color-hex').value;
  const name = document.getElementById('edit-color-name').value.trim() || hex;
  if (!hex) return;
  editColors.push({ color: hex, nombre: name });
  document.getElementById('edit-color-name').value = '';
  renderEditColors();
}

function removeEditColor(i) { editColors.splice(i, 1); renderEditColors(); }

function renderEditColors() {
  const container = document.getElementById('edit-colors-list');
  if (!editColors.length) { container.innerHTML = '<span class="hint-text">Sin variantes</span>'; return; }
  container.innerHTML = editColors.map((c, i) => `
    <div class="form-color-chip">
      <span class="fcc-dot" style="background:${escHtml(c.color)}"></span>
      <span>${escHtml(c.nombre)}</span>
      <button type="button" onclick="removeEditColor(${i})"><i data-lucide="x" class="lucide-sm"></i></button>
    </div>`).join('');
  lucide.createIcons();
}

